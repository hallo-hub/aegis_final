# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Nur für "guild" Command-Deploy in der Entwicklung nötig (leer lassen = global deploy)
DEV_GUILD_ID=

# Datenbank (Prisma / PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/security_bot?schema=public"

# Logging
LOG_LEVEL=info

# Optional: Owner IDs (kommagetrennt) - Bot-Owner haben globalen Zugriff auf Notfall-Commands
BOT_OWNER_IDS=
